# Private Toolbox runtime settings. Install as .env with mode 0600.
# Core TOOLBOX_API_KEY must match this value. Generate with openssl rand -hex 32.
TOOLBOX_API_KEY=
# Gateway TOOLBOX_API_KEY goes here, not the model server's own key.
VLM_API_KEY=
# Example: http://gateway.internal:8002/v1/vlm; never use the raw model port.
VLM_SERVE_URL=
# These are local Toolbox limits. The single-process gateway owns the global
# limit of two calls and must be configured independently on the model host.
VLM_MAX_CONCURRENCY=4
VLM_TIMEOUT_SECONDS=2700
VLM_SLOT_WAIT_SECONDS=120
# New, private production credentials shared with the MinIO services.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
TOOLBOX_ARTIFACT_FALLBACK_MODE=disabled
# Set only from measured peak usage. Zero preserves the uncapped baseline.
MINERU_MEMORY_LIMIT=0
LOG_LEVEL=INFO
