# VLM gateway on the model server's host. Copy to .env, chmod 600.

# Toolbox image to run; the gateway is the same image in gateway mode. Pin a
# release or a sha-<commit> tag and update it on purpose.
TOOLBOX_IMAGE_TAG=release-0.2.0

# Address and port the gateway listens on: the host's internal address, which
# the environments' Toolboxes reach.
GATEWAY_HOST=172.16.109.33
GATEWAY_PORT=8002

# Key the environments' Toolboxes send (their VLM_API_KEY). Generate with
# openssl rand -hex 32.
TOOLBOX_API_KEY=

# llama-server, on loopback, and its key (LLAMA_API_KEY in
# /etc/llama-server.env). During the switch, LLAMA_SERVER_URL can point at the
# server's old address until it moves to loopback.
LLAMA_SERVER_URL=http://127.0.0.1:8080
VLM_API_KEY=

# The gateway's own wait for llama-server's answer (not the environments'
# VLM_TIMEOUT_SECONDS, which must outlast this plus the slot wait below).
VLM_TIMEOUT_SECONDS=600
# Equal to llama-server's --parallel.
VLM_MAX_CONCURRENCY=2
# How long a request waits for one of those slots.
VLM_SLOT_WAIT_SECONDS=1800
