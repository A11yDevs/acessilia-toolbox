# Provider endpoints. Copy to `.env` and adjust; `.env` is never committed.
# Providers run out of process so the toolbox image stays model-free.

DOCLING_SERVE_URL=http://localhost:5001
DOCLING_SERVE_IMAGE=ghcr.io/docling-project/docling-serve-cpu:v1.32.0
DOCLING_SERVE_PORT=5001
DOCLING_SERVE_ENABLE_UI=false

# Path to the provider topology consumed by the provider registry.
TOOLBOX_PROVIDERS_CONFIG=providers-config.yaml

# REST facade
TOOLBOX_HOST=0.0.0.0
TOOLBOX_PORT=8000
