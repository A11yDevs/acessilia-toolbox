# Provider endpoints. Copy to `.env` and adjust; `.env` is never committed.
# Providers run out of process so the toolbox image stays model-free.
#
# Defaults use Docker Compose service names (docker-compose.staging.yml).
#
# Sidecar images: leave the commented *_IMAGE lines unset to use the images CI
# publishes on GHCR (ghcr.io/a11ydevs/acessilia-toolbox-<sidecar>); set one only
# to run a locally built sidecar (docs/installation.md, "Sidecar images").
# For local development (without Docker), override to localhost:
#   DOCLING_SERVE_URL=http://localhost:5001
#   MINIO_URL=http://localhost:9000
#   VALKEY_URL=redis://localhost:6379

DOCLING_SERVE_URL=http://docling-serve:5001
DOCLING_SERVE_IMAGE=ghcr.io/docling-project/docling-serve-cpu:v1.32.0
DOCLING_SERVE_PORT=5001
DOCLING_SERVE_ENABLE_UI=false

# MinerU (document structure/layout/OCR provider), CPU pipeline image built
# by CI from docker/mineru-cpu.Dockerfile.
# mineru-api listens on 8000 inside its container; MINERU_SERVE_PORT only maps
# that port on the host, so the service-to-service URL must use 8000.
MINERU_SERVE_URL=http://mineru-serve:8000
# MINERU_SERVE_IMAGE=mineru:latest
MINERU_SERVE_PORT=5002
MINERU_DEVICE_MODE=cpu

# Nougat (visual document transcription provider for scientific documents/math).
NOUGAT_SERVE_URL=http://nougat-serve:5004
# NOUGAT_SERVE_IMAGE=nougat:latest
NOUGAT_SERVE_PORT=5004
NOUGAT_MODEL_TAG=0.1.0-base
NOUGAT_EARLY_STOPPING=false

# Audiveris (optical music recognition sidecar). Image wraps the Java
# Audiveris CLI + Tesseract behind a small HTTP wrapper.
AUDIVERIS_SERVE_URL=http://audiveris-serve:5003
AUDIVERIS_SERVE_PORT=5003
# AUDIVERIS_SERVE_IMAGE=audiveris-serve:latest

# RapidLaTeXOCR (lightweight math formula recognition sidecar).
RAPID_LATEX_OCR_URL=http://rapid-latex-ocr:5004
RAPID_LATEX_OCR_PORT=5005
# RAPID_LATEX_OCR_IMAGE=rapid-latex-ocr:latest

# RapidOCR page orientation sidecar (image.page.orient). Detects and corrects
# a page rotated by 0/90/180/270 degrees before downstream layout extraction.
RAPIDOCR_ORIENT_URL=http://rapidocr-orient:5006
RAPIDOCR_ORIENT_PORT=5006
# RAPIDOCR_ORIENT_IMAGE=rapidocr-orient:latest

# Export sidecar: Pandoc + frozen TeX Live for document.export.pdf_ua, and the
# same Pandoc for document.export.docx. The output is stored in the artifact
# store, so these capabilities need MinIO (or the filesystem store) configured.
PDF_UA_RENDER_URL=http://pdf-ua-render:5007
PDF_UA_RENDER_PORT=5007
# PDF_UA_RENDER_IMAGE=pdf-ua-render:latest

# PDF/UA validation sidecar (pdf.validate.pdf_ua): pinned veraPDF CLI.
VERAPDF_VALIDATE_URL=http://verapdf-validate:5008
VERAPDF_VALIDATE_PORT=5008
# VERAPDF_VALIDATE_IMAGE=verapdf-validate:latest

# Math speech sidecar (math.convert, math.verbalize): MathJax for LaTeX to
# MathML, MathCAT for pt-BR speech and math braille (CMU, Nemeth, UEB).
MATH_SPEECH_URL=http://math-speech:5009
MATH_SPEECH_PORT=5009
# MATH_SPEECH_IMAGE=math-speech:latest

# Vision-language model server (document.ocr.page, document.adjudicate.page,
# document.adjudicate.region): any OpenAI-compatible chat API. In production use
# the internal address of the VLM VM, not its public hostname.
VLM_SERVE_URL=http://vlm:8080
# Bearer token for the VLM server (llama-server --api-key); empty sends none.
VLM_API_KEY=

# Path to the provider topology consumed by the provider registry.
TOOLBOX_PROVIDERS_CONFIG=providers-config.yaml

# Artifact storage and cache run as external services.
MINIO_URL=http://minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Set real credentials in .env; these are placeholders and .env is gitignored.
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-too

VALKEY_URL=redis://valkey:6379
VALKEY_PORT=6379

# REST facade
TOOLBOX_HOST=0.0.0.0
TOOLBOX_PORT=8002

# API Key authentication for REST endpoints (every endpoint except /v1/health).
# Required: the Toolbox refuses to start without it.
# Generate a key with: openssl rand -hex 32
TOOLBOX_API_KEY=
# Local development only: 1 starts without TOOLBOX_API_KEY, every endpoint open.
# Never set it on a shared or exposed host.
TOOLBOX_ALLOW_UNAUTHENTICATED=
