# Remote Toolbox the E2E smoke tests (tests/e2e) run against.
# Copy to .env.e2e (git-ignored) and fill in; tests/e2e/conftest.py loads it.
# Variables already set in the environment take precedence over this file.
#
# These describe a Toolbox the tests call as a client. They are not the
# server settings in .env: there TOOLBOX_API_KEY is the key this server requires.

# Base URL, without a trailing slash. Unset or empty: the E2E tests are skipped.
TOOLBOX_BASE_URL=https://www.acessilia3.inf.ufg.br/toolbox
# API key of that Toolbox, sent as a Bearer token. Empty: no Authorization header.
TOOLBOX_API_KEY=
