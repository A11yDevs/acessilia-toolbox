{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a11y-devs:schema:processed-text:1.0.0",
  "title": "Processed Text",
  "description": "Post-processed text with region markers, deduplication, and per-page structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pages",
    "full_text",
    "page_count"
  ],
  "properties": {
    "pages": {
      "type": "array",
      "description": "Processed pages with text and metadata.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_number",
          "text",
          "element_count"
        ],
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page number."
          },
          "text": {
            "type": "string",
            "description": "Processed text for this page."
          },
          "element_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of elements on this page."
          }
        }
      }
    },
    "full_text": {
      "type": "string",
      "description": "Concatenated full text from all pages."
    },
    "page_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of processed pages."
    },
    "markers_applied": {
      "type": "array",
      "description": "List of region marker types applied.",
      "items": {
        "type": "string"
      }
    },
    "deduplicated_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of duplicate content items removed."
    },
    "overlap_removed_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of overlapping items removed."
    }
  }
}