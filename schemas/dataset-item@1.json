{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a11y-devs:schema:dataset-item:1",
  "title": "DatasetItem",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "dataset": { "type": "string" },
    "split": { "type": "string" },
    "revision": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/DatasetArtifactRef" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/definitions/DatasetArtifactRef" }
    },
    "metadata": { "type": "object" }
  },
  "required": ["id"],
  "definitions": {
    "DatasetArtifactRef": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" },
        "mirrored": { "type": "boolean" },
        "artifact_id": { "type": "string" }
      },
      "required": ["path"]
    }
  }
}