{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:a11y-devs:schema:ocr-result:1.0.0",
  "title": "OCR Result",
  "description": "Result of OCR text extraction from a document image or page, with per-item confidence and bounding boxes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "item_count",
    "full_text",
    "language"
  ],
  "properties": {
    "items": {
      "type": "array",
      "description": "Recognized text items with metadata.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "label",
          "confidence",
          "page",
          "bbox"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "Recognized text content."
          },
          "label": {
            "type": "string",
            "description": "Semantic label (e.g. paragraph, heading, table)."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Recognition confidence score."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Source page number."
          },
          "bbox": {
            "type": "array",
            "description": "Bounding box [left, top, right, bottom] in page coordinates.",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "item_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of recognized text items."
    },
    "full_text": {
      "type": "string",
      "description": "Concatenated full text from all items."
    },
    "language": {
      "type": "string",
      "description": "OCR language used for recognition (e.g. pt-BR)."
    }
  }
}