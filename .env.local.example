# Provider endpoints — local development variant.
# Copy to .env.local and fill in real credentials.
# .env.local is gitignored — never commit secrets.
#
# Load with: export $(cat .env.local | xargs)
# Then run: uvicorn acessilia_toolbox.api.app:create_app --factory --host 0.0.0.0 --port 8002 --reload
# Or: ./scripts/run-local.sh

DOCLING_SERVE_URL=http://localhost:5001
DOCLING_SERVE_PORT=5001
DOCLING_SERVE_ENABLE_UI=false

# MinerU — local dev usually runs mineru-api natively (venv) or via Docker CPU:
#   mineru-api --host 0.0.0.0 --port 8000   (then set URL to http://localhost:5002)
MINERU_SERVE_URL=http://localhost:5002
MINERU_SERVE_PORT=5002

# Audiveris sidecar (optional; only needed for music.omr via audiveris):
AUDIVERIS_SERVE_URL=http://localhost:5003
AUDIVERIS_SERVE_PORT=5003

TOOLBOX_PROVIDERS_CONFIG=providers-config.yaml

MINIO_URL=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-too

VALKEY_URL=redis://localhost:6379
VALKEY_PORT=6379

TOOLBOX_HOST=0.0.0.0
TOOLBOX_PORT=8002