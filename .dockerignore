# Build artefacts — the image ships only what pyproject.toml declares.
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# The dataset is large and meant for testing, not production.
tests/fixtures/dataset/

# Git and CI artefacts.
.git/
.gitmodules
.github/

# Environment credentials never ship in the image.
.env
.env.example

# Provider configuration default is safe to ship; secrets come via env vars.
# providers-config.yaml — shipped with the image.

# macOS artefacts.
.DS_Store